{
  "name": "dsh-notify",
  "version": "0.2.6",
  "description": "Desktop notifications for DeepSeek Harness: alert you the moment an agent stops — reply finished, question asked, or approval requested — and click through to the exact conversation in the dsh web UI. 当 AI 停止回复 / 向你提问 / 请求批准时发送桌面通知并一键跳回对应对话。",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "dsh-plugin",
    "notification",
    "desktop-notification",
    "notify",
    "提醒",
    "通知"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6"
  }
}
